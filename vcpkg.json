{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "dependencies": [
    "curl",
    "libiconv",
    "libxml2",
    "tl-expected",
    "cli11",
    "fmt",
    "spdlog",
    "nlohmann-json",
    "simdjson",
    "yaml-cpp",
    "reproc",
    "msgpack-c",
    {
      "name": "libsolv",
      "features": ["conda", "lzma", "bzip2", "zstd"]
    },
    {
      "name": "winreg",
      "platform": "windows"
    },
    {
      "features": ["bzip2", "lz4", "lzma", "lzo", "crypto", "zstd"],
      "name": "libarchive"
    },
    {
      "host": true,
      "name": "vcpkg-cmake"
    },
    {
      "host": true,
      "name": "vcpkg-cmake-config"
    }
  ],
  "homepage": "https://github.com/mamba-org/mamba",
  "license": "BSD-3-Clause",
  "name": "micromamba",
  "supports": "x64 | (arm64 & !windows)"
}
